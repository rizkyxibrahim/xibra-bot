{
    "name": "xibra-bot",
    "version": "0.1.0",
    "private": true,
    "description": "Telegram interface for Xibra Platform",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.build.json",
        "start": "node dist/index.js",
        "typecheck": "tsc",
        "test": "vitest run",
        "smoke": "tsx scripts/smoke.ts",
        "print-signature": "tsx scripts/print-signature.ts"
    },
    "dependencies": {
        "grammy": "^1.46.0"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.1.0"
    }
}
