# Token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Origin of the Xibra API (no path). Use https outside local development.
XIBRA_API_BASE_URL=http://127.0.0.1:8000

# Must match XIBRA_BOT_KEY_ID and XIBRA_BOT_SECRET in the API environment.
XIBRA_BOT_KEY_ID=xibra-bot-v1
XIBRA_BOT_SECRET=

XIBRA_API_TIMEOUT_MS=10000
LOG_LEVEL=info